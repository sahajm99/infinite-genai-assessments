# Copy to .env and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_BACKEND=openai        # openai | local
MEMORY_BACKEND=memory       # memory | redis
REDIS_URL=redis://localhost:6379/0
CHROMA_DIR=./.chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
SCORE_THRESHOLD=0.35
ESCALATE_THRESHOLD=0.30
MEMORY_WINDOW=6
