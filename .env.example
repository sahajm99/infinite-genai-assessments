# Copy to .env and fill in. Only OPENAI_API_KEY is required.
#
# ── Option A: OpenAI (default) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_BACKEND=openai        # openai | local
#
# ── Option B: Groq (open-source models) ───────────────────────────────────
# Groq is OpenAI-compatible for CHAT, but has NO embeddings API, so pair it
# with local HuggingFace embeddings. Uncomment these four and comment out the
# OpenAI block above:
# OPENAI_API_KEY=gsk_your_groq_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile      # or llama-3.1-8b-instant, openai/gpt-oss-20b
# EMBED_BACKEND=local                    # embeddings run offline via sentence-transformers
MEMORY_BACKEND=memory       # memory | redis
REDIS_URL=redis://localhost:6379/0
CHROMA_DIR=./.chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
SCORE_THRESHOLD=0.35
ESCALATE_THRESHOLD=0.30
MEMORY_WINDOW=6
